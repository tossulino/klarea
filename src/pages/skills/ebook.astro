---
import Page from '../../layouts/Page.astro';

const superficies = [
  {
    n: '01',
    t: 'Claude Chat',
    sub: 'A conversa',
    d: 'Você pergunta, ele responde, você copia a resposta para onde ela precisa ir. O trabalho de levar a saída até o destino continua sendo seu.',
    skill: 'A skill entra como conhecimento: ele responde já dentro do padrão da casa, sem você repetir o briefing.',
  },
  {
    n: '02',
    t: 'Claude Cowork',
    sub: 'A sessão de trabalho',
    d: 'Você entrega a tarefa. Ele abre as pastas e as ferramentas que você autorizou, executa e devolve o arquivo pronto para revisão. Roda no desktop, na web e na nuvem, inclusive em horário agendado, sem você na frente.',
    skill: 'A skill entra como procedimento: ele executa do jeito certo na primeira vez, e o resultado não depende de quem pediu.',
  },
  {
    n: '03',
    t: 'Claude Code',
    sub: 'O terminal',
    d: 'A superfície de quem constrói software. Mesma lógica do Cowork, com acesso direto ao repositório, aos testes e ao deploy.',
    skill: 'A skill entra versionada junto com o código: a regra de arquitetura vive no repositório, não na cabeça do time.',
  },
