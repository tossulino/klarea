  <script is:inline>
    // Conversão: preserva o evento de lead e o rótulo do Google Ads do site anterior.
    (function () {
      var f = document.getElementById('leadForm');
      if (f) {
        f.addEventListener('submit', function () {
          if (typeof gtag !== 'function') return;
          gtag('event', 'generate_lead', { origem: 'formulario_contato' });
          gtag('event', 'conversion', {
            send_to: 'AW-18391505425/VOoYCNnUmOIcEJG04MFE',
            value: 1.0,
            currency: 'BRL',
          });
        });
      }

      // Fase corrente do percurso: travada num relógio, parada fora da tela e sob reduced-motion.
      var groups = document.querySelectorAll('#fases > g');
      if (!groups.length) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
      var i = 0, timer = null;
      function paint() {
        groups.forEach(function (g, k) {
          var c = g.querySelector('.ctrl');
          var n = g.querySelector('.cn');
          // o numeral fica fora do circulo, entao mantem a cor do percurso sempre;
          // o preenchimento do controle e o unico sinal de "agora".
          c.classList.toggle('is-now', k === i);
        });
        i = (i + 1) % groups.length;
      }
      function start() { if (timer || reduce.matches) return; timer = setInterval(paint, 2600); }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      paint();
      var target = document.querySelector('.profile');
      if (target && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (es) {
          es.forEach(function (e) { e.isIntersecting ? start() : stop(); });
        }, { threshold: 0.3 }).observe(target);
      }
    })();
  </script>
